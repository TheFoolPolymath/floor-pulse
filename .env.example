# Copy this file to .env and fill it in. Never commit .env.

# ---- Database (TiDB or MySQL 8). Required. ----
# Easiest: one line. Example: mysql://user:password@gateway01.region.prod.aws.tidbcloud.com:4000/floor_pulse
DATABASE_URL=
# Or split (used only when DATABASE_URL is empty)
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=floor_pulse
# TLS is on by default. Set false only for a local MySQL on your own machine.
DB_SSL=true

# ---- Google sign-in. Required for staff to sign in. ----
# OAuth client ID (Web application) from Google Cloud Console
GOOGLE_CLIENT_ID=

# ---- Google Sheets. Required. ----
# The sheet that keeps Attendance, KPI_MIS (logins), Calls_MIS (calls), Efficiency_Log and Audit_Log
SHEET_ID=
# The backend team's sheet (optional). Shared with the service account as Viewer.
BACKEND_SHEET_ID=
# Service account key: paste the JSON on one line, OR point to a file. Use one of the two.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# ---- Secrets. Required. Keep them safe: losing DATA_KEY makes directory secrets unreadable. ----
# At least 32 characters. Example: openssl rand -hex 32
SESSION_SECRET=
# 32 random bytes as base64. Example: openssl rand -base64 32
DATA_KEY=

# ---- Website and server ----
PORT=8787
# Your site's address, if the website is served from another domain (comma separated). Leave empty when the server serves the website.
ALLOWED_ORIGINS=
# Set false if a separate host serves the website
SERVE_STATIC=true
# Branch name shown in the header
BRANCH_NAME=Mumbai Branch

# ---- Behaviour ----
# How long a read of the sheets is reused (seconds). Higher = faster refresh, slightly older numbers.
SNAPSHOT_TTL_SECONDS=45
# How often the efficiency log is written (minutes, during the shift)
EFFICIENCY_EVERY_MIN=10
# How often the backend sheet is read (minutes). 0 = never automatically.
SYNC_EVERY_MIN=10
# Backend sheet tabs to read, comma separated. Empty = all tabs.
BACKEND_TABS=
# How typed dates in the backend sheet are read: MDY (06/04 = June 4) or DMY (06/04 = 6 April)
TEXT_DATE_ORDER=MDY
# Count "NI" (not interested) as a login in the numbers: true or false
COUNT_NI_AS_LOGIN=true
